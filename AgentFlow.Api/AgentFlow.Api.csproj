<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.28.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentFlow.Agent\AgentFlow.Agent.csproj" />
    <!-- Built with the API, but not referenced as a library: it is launched as a child process. -->
    <ProjectReference Include="..\AgentFlow.McpServer\AgentFlow.McpServer.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Bundle the MCP server into <publish>/mcp-server/ so the API can launch it when deployed. -->
  <Target Name="PublishMcpServer" AfterTargets="Publish">
    <MSBuild Projects="..\AgentFlow.McpServer\AgentFlow.McpServer.csproj"
             Targets="Publish"
             Properties="NoBuild=true;Configuration=$(Configuration);PublishDir=$(PublishDir)mcp-server\" />
  </Target>

</Project>
